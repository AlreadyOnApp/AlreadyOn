<?xml version="1.0" encoding="utf-8"?>
<!-- Compose draws the application theme over a no-action-bar Android window. -->
<resources>
    <style name="Theme.AlreadyOn" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#101820</item>
        <item name="android:navigationBarColor">#101820</item>
    </style>
</resources>
